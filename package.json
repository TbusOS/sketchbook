{
  "name": "sketchbook",
  "version": "1.0.0",
  "private": true,
  "description": "Every open-source project by TbusOS, in one hand-drawn place.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=20" },
  "scripts": {
    "fetch": "node scripts/fetch.mjs",
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test test/*.test.mjs",
    "refresh": "node scripts/fetch.mjs && node scripts/build.mjs && node scripts/check.mjs"
  },
  "dependencies": {
    "subset-font": "2.9.0",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "playwright": "1.59.1",
    "sharp": "0.34.4"
  }
}
